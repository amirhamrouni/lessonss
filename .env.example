VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# CEFR curriculum rollout controls. Omit or set true to enable.
VITE_CURRICULUM_V2=true
VITE_ENABLE_B1=true
VITE_ENABLE_B2=true
VITE_ENABLE_C1=true
VITE_AI_EVALUATION=true

# Server-only. Never expose these with a VITE_ prefix.
GEMINI_API_KEY=
# Optional model overrides. The server has explicit safe defaults.
GEMINI_MODEL=gemini-3.7-flash
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
FIREBASE_PROJECT_ID=

# Firebase Admin: choose ONE credential form.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or split credentials, useful for secret stores that handle multiline values separately.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Production recommendation. When true, AI endpoints fail closed instead of
# falling back to per-instance memory quotas if Firebase Admin is unavailable.
REQUIRE_PERSISTENT_QUOTA=true
