VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# CEFR curriculum rollout controls. Omit or set true to enable.
# These provide a non-destructive rollback path for advanced curriculum UI/routes.
VITE_CURRICULUM_V2=true
VITE_ENABLE_B1=true
VITE_ENABLE_B2=true
VITE_ENABLE_C1=true
VITE_AI_EVALUATION=true

# Server-only. Never expose these with a VITE_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Recommended for production after FIREBASE_SERVICE_ACCOUNT_JSON is configured.
# When enabled, AI endpoints fail closed instead of falling back to per-instance memory quotas.
REQUIRE_PERSISTENT_QUOTA=true
